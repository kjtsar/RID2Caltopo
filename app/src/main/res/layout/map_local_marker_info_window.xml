<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/local_marker_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/local_marker_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fadingEdge="vertical"
        android:maxLines="7"
        android:scrollbars="vertical"
        android:textColor="#424242"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/local_marker_snapshot"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:adjustViewBounds="true"
        android:background="#212121"
        android:contentDescription="Open clue snapshot"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <Button
        android:id="@+id/local_marker_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Delete local copy" />
</LinearLayout>
