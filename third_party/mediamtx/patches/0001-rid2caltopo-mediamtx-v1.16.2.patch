+func TestPathOverridePublisherKeepsExistingReaders(t *testing.T) {
+	p, ok := newInstance("rtmp: no\n" +
+		"paths:\n" +
+		"  all_others:\n")
+	require.Equal(t, true, ok)
+	defer p.Close()
+
+	medi := test.UniqueMediaH264()
+
+	s1 := gortsplib.Client{}
+	err := s1.StartRecording("rtsp://localhost:8554/teststream",
+		&description.Session{Medias: []*description.Media{medi}})
+	require.NoError(t, err)
+	defer s1.Close()
+
+	u, err := base.ParseURL("rtsp://localhost:8554/teststream")
+	require.NoError(t, err)
+
+	reader := gortsplib.Client{
+		Scheme: u.Scheme,
+		Host:   u.Host,
+	}
+
+	err = reader.Start()
+	require.NoError(t, err)
+	defer reader.Close()
+
+	desc, _, err := reader.Describe(u)
+	require.NoError(t, err)
+
+	err = reader.SetupAll(desc.BaseURL, desc.Medias)
+	require.NoError(t, err)
+
+	firstPacketReceived := make(chan struct{})
+	secondPacketReceived := make(chan struct{})
+	packetCount := 0
+
+	reader.OnPacketRTP(desc.Medias[0], desc.Medias[0].Formats[0], func(pkt *rtp.Packet) {
+		packetCount++
+
+		switch packetCount {
+		case 1:
+			require.Equal(t, []byte{5, 11, 12, 13, 14}, pkt.Payload)
+			close(firstPacketReceived)
+
+		case 2:
+			require.Equal(t, []byte{5, 15, 16, 17, 18}, pkt.Payload)
+			close(secondPacketReceived)
+		}
+	})
+
+	_, err = reader.Play(nil)
+	require.NoError(t, err)
+
+	err = s1.WritePacketRTP(medi, &rtp.Packet{
+		Header: rtp.Header{
+			Version:        0x02,
+			PayloadType:    96,
+			SequenceNumber: 57898,
+			Timestamp:      345234000,
+			SSRC:           978651231,
+			Marker:         true,
+		},
+		Payload: []byte{5, 11, 12, 13, 14},
+	})
+	require.NoError(t, err)
+
+	<-firstPacketReceived
+
+	s2 := gortsplib.Client{}
+	err = s2.StartRecording("rtsp://localhost:8554/teststream",
+		&description.Session{Medias: []*description.Media{medi}})
+	require.NoError(t, err)
+	defer s2.Close()
+
+	err = s1.Wait()
+	require.EqualError(t, err, "EOF")
+
+	err = s2.WritePacketRTP(medi, &rtp.Packet{
+		Header: rtp.Header{
+			Version:        0x02,
+			PayloadType:    96,
+			SequenceNumber: 57899,
+			Timestamp:      345234345,
+			SSRC:           978651231,
+			Marker:         true,
+		},
+		Payload: []byte{5, 15, 16, 17, 18},
+	})
+	require.NoError(t, err)
+
+	select {
+	case <-secondPacketReceived:
+	case <-time.After(2 * time.Second):
+		t.Fatal("reader was disconnected during publisher override")
+	}
+}
