+package description
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestSessionMarshalFallbackTitle(t *testing.T) {
+	byts, err := Session{}.Marshal()
+	require.NoError(t, err)
+	require.Contains(t, string(byts), "\r\ns=MediaMTX\r\n")
+	require.NotContains(t, string(byts), "\r\ns= \r\n")
+}
+
+func TestSessionMarshalExplicitTitle(t *testing.T) {
+	byts, err := Session{Title: "Drone Feed"}.Marshal()
+	require.NoError(t, err)
+	require.Contains(t, string(byts), "\r\ns=Drone Feed\r\n")
+	require.False(t, strings.Contains(string(byts), "\r\ns=MediaMTX\r\n"))
+}
